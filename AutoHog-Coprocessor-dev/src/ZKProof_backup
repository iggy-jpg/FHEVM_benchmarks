template<typename P>
Proof prove(
    const PublicParams<P>& params,
    const PublicCommit<P>& public_commit,
    const PrivateCommit<P>& private_commit,
    const std::vector<uint8_t>& metadata,
    ComputeLoad load,
    const std::array<uint8_t, SEED_LEN>& seed
) {
    (void)load;
    (void)seed;

    const size_t d = params.d;
    const size_t k = params.k;

    __uint128_t decoded_q = decode_q(params.q);
    uint64_t delta = (uint64_t)(decoded_q / params.t);

    auto r1 = compute_r1(
        private_commit.e1, public_commit.c1, public_commit.a, private_commit.r,
        d, decoded_q
    );
    auto r2 = compute_r2(
        private_commit.e2, public_commit.c2, private_commit.m, public_commit.b,
        private_commit.r, d, delta, decoded_q
    );

    auto witness = construct_witness(
    private_commit.r, private_commit.m,
    private_commit.e1, private_commit.e2,
    r1, r2,
    d,
    params.b, params.b_r, params.t,
    params.msbs_zero_padding_bit_count
    );

    auto append_i64 = [](std::vector<uint8_t>& dst, int64_t v) {
        uint8_t b[8];
        std::memcpy(b, &v, 8);
        dst.insert(dst.end(), b, b + 8);
    };

    const size_t used_n = std::min(witness.size(), params.n);

    std::vector<blst_scalar> w_scalars(used_n);
    for (size_t i = 0; i < used_n; i++) {
        uint8_t bit_bytes[32] = {0};
        bit_bytes[0] = witness[i] & 1;
        blst_scalar_from_lendian(&w_scalars[i], bit_bytes);
    }

    blst_p2_affine* g_hat_list = static_cast<blst_p2_affine*>(params.g_hat_list_ptr);
    blst_p2 c_hat_msm;
    msm_g2(&c_hat_msm, g_hat_list, w_scalars.data(), used_n);

    const blst_p2_affine* g2_gen = blst_p2_affine_generator();
    blst_p2 g2_term;
    blst_p2_from_affine(&g2_term, g2_gen);

    // ============================================

    // ============================================
    blst_scalar gamma = compute_gamma_from_public_commit(params, public_commit, metadata);


    blst_p2 c_hat = c_hat_msm;
    blst_p2 gamma_term = g2_term;
    blst_p2_mult(&gamma_term, &gamma_term, gamma.b, 256);
    blst_p2_add(&c_hat, &c_hat, &gamma_term);

    Proof proof;
    blst_p2_to_affine(static_cast<blst_p2_affine*>(proof.c_hat_ptr), &c_hat);

    uint8_t c_hat_bytes[96];
    blst_p2_affine_compress(
        c_hat_bytes,
        static_cast<blst_p2_affine*>(proof.c_hat_ptr)
    );


    std::vector<uint8_t> t_y;
    t_y.insert(t_y.end(), params.hash_ds.begin(), params.hash_ds.end());
    t_y.insert(t_y.end(), c_hat_bytes, c_hat_bytes + 96);
    for (auto v : public_commit.a)  append_i64(t_y, v);
    for (auto v : public_commit.b)  append_i64(t_y, v);
    for (auto v : public_commit.c1) append_i64(t_y, v);
    for (auto v : public_commit.c2) append_i64(t_y, v);
    t_y.insert(t_y.end(), metadata.begin(), metadata.end());

    uint8_t y_bytes[32];
    shake256_hash(t_y.data(), t_y.size(), y_bytes, 32);

    blst_scalar y_scalar;
    blst_scalar_from_lendian(&y_scalar, y_bytes);


    std::vector<uint8_t> t_gamma_y;
    t_gamma_y.insert(t_gamma_y.end(), params.hash_w_ds.begin(), params.hash_w_ds.end());
    t_gamma_y.insert(t_gamma_y.end(), y_bytes, y_bytes + 32);
    t_gamma_y.insert(t_gamma_y.end(), c_hat_bytes, c_hat_bytes + 96);
    for (auto v : public_commit.a)  append_i64(t_gamma_y, v);
    for (auto v : public_commit.b)  append_i64(t_gamma_y, v);
    for (auto v : public_commit.c1) append_i64(t_gamma_y, v);
    for (auto v : public_commit.c2) append_i64(t_gamma_y, v);
    t_gamma_y.insert(t_gamma_y.end(), metadata.begin(), metadata.end());

    uint8_t gamma_y_bytes[32];
    shake256_hash(t_gamma_y.data(), t_gamma_y.size(), gamma_y_bytes, 32);

    blst_scalar gamma_y;
    blst_scalar_from_lendian(&gamma_y, gamma_y_bytes);

    blst_p1_affine* g_list = static_cast<blst_p1_affine*>(params.g_list_ptr);
    const blst_p1_affine* g1_gen = blst_p1_affine_generator();

    // c_y = gamma_y * g1 + sum(witness[i] * y * g_list[i])
    blst_p1 c_y;
    blst_p1_from_affine(&c_y, g1_gen);
    blst_p1_mult(&c_y, &c_y, gamma_y.b, 256);

    for (size_t i = 0; i < used_n; i++) {
        if ((witness[i] & 1) == 0) continue;
        blst_p1 term;
        blst_p1_from_affine(&term, &g_list[i]);
        blst_p1_mult(&term, &term, y_scalar.b, 256);
        blst_p1_add(&c_y, &c_y, &term);
    }

    blst_p1_to_affine(static_cast<blst_p1_affine*>(proof.c_y_ptr), &c_y);

    blst_p1_affine zero1_aff;
    std::memset(&zero1_aff, 0, sizeof(zero1_aff));
    std::memcpy(static_cast<blst_p1_affine*>(proof.pi_ptr), &zero1_aff, sizeof(zero1_aff));
    std::memcpy(static_cast<blst_p1_affine*>(proof.c_h_ptr), &zero1_aff, sizeof(zero1_aff));

    return proof;
}

