template<typename P>
static blst_scalar compute_gamma_from_public_commit(
    const PublicParams<P>& params,
    const PublicCommit<P>& public_commit,
    const std::vector<uint8_t>& metadata
) {
    auto append_i64 = [](std::vector<uint8_t>& dst, int64_t v) {
        uint8_t b[8];
        std::memcpy(b, &v, 8);
        dst.insert(dst.end(), b, b + 8);
    };

    std::vector<uint8_t> t_gamma;
    t_gamma.insert(t_gamma.end(), params.hash_gamma_ds.begin(), params.hash_gamma_ds.end());

    for (auto v : public_commit.a)  append_i64(t_gamma, v);
    for (auto v : public_commit.b)  append_i64(t_gamma, v);
    for (auto v : public_commit.c1) append_i64(t_gamma, v);
    for (auto v : public_commit.c2) append_i64(t_gamma, v);
    t_gamma.insert(t_gamma.end(), metadata.begin(), metadata.end());

    uint8_t gamma_bytes[32];
    shake256_hash(t_gamma.data(), t_gamma.size(), gamma_bytes, 32);

    blst_scalar gamma;
    blst_scalar_from_lendian(&gamma, gamma_bytes);
    return gamma;
}

