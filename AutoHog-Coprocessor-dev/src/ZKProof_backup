static void msm_g2(blst_p2* out, const blst_p2_affine* points, const blst_scalar* scalars, size_t n) {
    if (n == 0) {
        memset(out, 0, sizeof(blst_p2));
        return;
    }


    std::vector<const blst_p2_affine*> point_ptrs(n);
    for (size_t i = 0; i < n; i++) {
        point_ptrs[i] = &points[i];
    }


    std::vector<uint8_t> scalar_bytes(n * 32);
    std::vector<const uint8_t*> scalar_ptrs(n);
    for (size_t i = 0; i < n; i++) {
        blst_lendian_from_scalar(&scalar_bytes[i * 32], &scalars[i]);
        scalar_ptrs[i] = &scalar_bytes[i * 32];
    }


    size_t scratch_size = blst_p2s_mult_pippenger_scratch_sizeof(n);
    std::vector<limb_t> scratch(scratch_size / sizeof(limb_t) + 1);


    blst_p2s_mult_pippenger(
        out,
        point_ptrs.data(),
        n,
        scalar_ptrs.data(),
        256,
        scratch.data()
    );
}

