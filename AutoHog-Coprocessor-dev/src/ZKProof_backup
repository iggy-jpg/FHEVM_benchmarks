template<typename P>
PrivateCommit<P> make_private_commit(
    const std::vector<int64_t>& r,
    const std::vector<int64_t>& e1,
    const std::vector<int64_t>& e2,
    const std::vector<int64_t>& m
) {

    if (r.size() != P::n || e1.size() != P::n || e2.size() != P::n || m.size() != P::n) {
        throw std::runtime_error("PrivateCommit vectors must have length P::n");
    }

    PrivateCommit<P> commit;
    commit.d = P::n;
    commit.k = P::n;
    commit.r = r;
    commit.e1 = e1;
    commit.e2 = e2;
    commit.m = m;
    return commit;
}

