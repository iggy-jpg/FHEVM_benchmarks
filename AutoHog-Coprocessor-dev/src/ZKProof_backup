Proof::Proof() {
    c_hat_ptr = new blst_p2_affine;
    c_y_ptr = new blst_p1_affine;
    c_h_ptr = new blst_p1_affine;
    pi_ptr = new blst_p1_affine;
    std::memset(c_hat_ptr, 0, sizeof(blst_p2_affine));
    std::memset(c_y_ptr, 0, sizeof(blst_p1_affine));
    std::memset(c_h_ptr, 0, sizeof(blst_p1_affine));
    std::memset(pi_ptr, 0, sizeof(blst_p1_affine));
}

Proof::~Proof() {
    delete static_cast<blst_p2_affine*>(c_hat_ptr);
    delete static_cast<blst_p1_affine*>(c_y_ptr);
    delete static_cast<blst_p1_affine*>(c_h_ptr);
    delete static_cast<blst_p1_affine*>(pi_ptr);
}

Proof::Proof(Proof&& other) noexcept {
    c_hat_ptr = other.c_hat_ptr;
    c_y_ptr = other.c_y_ptr;
    c_h_ptr = other.c_h_ptr;
    pi_ptr = other.pi_ptr;
    other.c_hat_ptr = nullptr;
    other.c_y_ptr = nullptr;
    other.c_h_ptr = nullptr;
    other.pi_ptr = nullptr;
}

Proof& Proof::operator=(Proof&& other) noexcept {
    if (this != &other) {
        delete static_cast<blst_p2_affine*>(c_hat_ptr);
        delete static_cast<blst_p1_affine*>(c_y_ptr);
        delete static_cast<blst_p1_affine*>(c_h_ptr);
        delete static_cast<blst_p1_affine*>(pi_ptr);
        c_hat_ptr = other.c_hat_ptr;
        c_y_ptr = other.c_y_ptr;
        c_h_ptr = other.c_h_ptr;
        pi_ptr = other.pi_ptr;
        other.c_hat_ptr = nullptr;
        other.c_y_ptr = nullptr;
        other.c_h_ptr = nullptr;
        other.pi_ptr = nullptr;
    }
    return *this;
}

std::vector<uint8_t> Proof::serialize() const {
    std::vector<uint8_t> buffer;
    uint8_t c_hat_bytes[96];
    blst_p2_affine_compress(c_hat_bytes, static_cast<const blst_p2_affine*>(c_hat_ptr));
    buffer.insert(buffer.end(), c_hat_bytes, c_hat_bytes + 96);
    uint8_t c_y_bytes[48];
    blst_p1_affine_compress(c_y_bytes, static_cast<const blst_p1_affine*>(c_y_ptr));
    buffer.insert(buffer.end(), c_y_bytes, c_y_bytes + 48);
    uint8_t c_h_bytes[48];
    blst_p1_affine_compress(c_h_bytes, static_cast<const blst_p1_affine*>(c_h_ptr));
    buffer.insert(buffer.end(), c_h_bytes, c_h_bytes + 48);
    uint8_t pi_bytes[48];
    blst_p1_affine_compress(pi_bytes, static_cast<const blst_p1_affine*>(pi_ptr));
    buffer.insert(buffer.end(), pi_bytes, pi_bytes + 48);
    return buffer;
}

Proof Proof::deserialize(const std::vector<uint8_t>& data) {
    if (data.size() != 240) throw std::runtime_error("Invalid proof size");
    Proof proof;
    blst_p2_uncompress(static_cast<blst_p2_affine*>(proof.c_hat_ptr), data.data());
    blst_p1_uncompress(static_cast<blst_p1_affine*>(proof.c_y_ptr), data.data() + 96);
    blst_p1_uncompress(static_cast<blst_p1_affine*>(proof.c_h_ptr), data.data() + 144);
    blst_p1_uncompress(static_cast<blst_p1_affine*>(proof.pi_ptr), data.data() + 192);
    return proof;
}

