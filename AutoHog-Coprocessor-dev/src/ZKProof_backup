template<typename P>
bool verify(
    const Proof& proof,
    const PublicParams<P>& params,
    const PublicCommit<P>& public_commit,
    const std::vector<uint8_t>& metadata
) {
    auto append_i64 = [](std::vector<uint8_t>& dst, int64_t v) {
        uint8_t b[8];
        std::memcpy(b, &v, 8);
        dst.insert(dst.end(), b, b + 8);
    };

    uint8_t c_hat_bytes[96];
    blst_p2_affine_compress(
        c_hat_bytes,
        static_cast<const blst_p2_affine*>(proof.c_hat_ptr)
    );


    std::vector<uint8_t> t_y;
    t_y.insert(t_y.end(), params.hash_ds.begin(), params.hash_ds.end());
    t_y.insert(t_y.end(), c_hat_bytes, c_hat_bytes + 96);
    for (auto v : public_commit.a)  append_i64(t_y, v);
    for (auto v : public_commit.b)  append_i64(t_y, v);
    for (auto v : public_commit.c1) append_i64(t_y, v);
    for (auto v : public_commit.c2) append_i64(t_y, v);
    t_y.insert(t_y.end(), metadata.begin(), metadata.end());

    uint8_t y_bytes[32];
    shake256_hash(t_y.data(), t_y.size(), y_bytes, 32);

    blst_scalar y_scalar;
    blst_scalar_from_lendian(&y_scalar, y_bytes);

    // ============================================

    // ============================================
    blst_scalar gamma = compute_gamma_from_public_commit(params, public_commit, metadata);


    std::vector<uint8_t> t_gamma_y;
    t_gamma_y.insert(t_gamma_y.end(), params.hash_w_ds.begin(), params.hash_w_ds.end());
    t_gamma_y.insert(t_gamma_y.end(), y_bytes, y_bytes + 32);
    t_gamma_y.insert(t_gamma_y.end(), c_hat_bytes, c_hat_bytes + 96);
    for (auto v : public_commit.a)  append_i64(t_gamma_y, v);
    for (auto v : public_commit.b)  append_i64(t_gamma_y, v);
    for (auto v : public_commit.c1) append_i64(t_gamma_y, v);
    for (auto v : public_commit.c2) append_i64(t_gamma_y, v);
    t_gamma_y.insert(t_gamma_y.end(), metadata.begin(), metadata.end());

    uint8_t gamma_y_bytes[32];
    shake256_hash(t_gamma_y.data(), t_gamma_y.size(), gamma_y_bytes, 32);

    blst_scalar gamma_y;
    blst_scalar_from_lendian(&gamma_y, gamma_y_bytes);

    const blst_p1_affine* g1_gen = blst_p1_affine_generator();
    const blst_p2_affine* g2_gen = blst_p2_affine_generator();


    blst_p2 C2, tmp2;
    blst_p2_from_affine(&C2, static_cast<const blst_p2_affine*>(proof.c_hat_ptr));
    blst_p2_from_affine(&tmp2, g2_gen);
    blst_p2_mult(&tmp2, &tmp2, gamma.b, 256);
    blst_p2_cneg(&tmp2, 1);
    blst_p2_add(&C2, &C2, &tmp2);


    blst_p1 C1, tmp1;
    blst_p1_from_affine(&C1, static_cast<const blst_p1_affine*>(proof.c_y_ptr));
    blst_p1_from_affine(&tmp1, g1_gen);
    blst_p1_mult(&tmp1, &tmp1, gamma_y.b, 256);
    blst_p1_cneg(&tmp1, 1);
    blst_p1_add(&C1, &C1, &tmp1);

    // yC2 = y * C2
    blst_p2 yC2 = C2;
    blst_p2_mult(&yC2, &yC2, y_scalar.b, 256);

    blst_p1_affine C1_aff;
    blst_p2_affine yC2_aff;
    blst_p1_to_affine(&C1_aff, &C1);
    blst_p2_to_affine(&yC2_aff, &yC2);


    blst_fp12 lhs, rhs;
    blst_miller_loop(&lhs, g2_gen, &C1_aff);
    blst_final_exp(&lhs, &lhs);

    blst_miller_loop(&rhs, &yC2_aff, g1_gen);
    blst_final_exp(&rhs, &rhs);

    return blst_fp12_is_equal(&lhs, &rhs);
}

