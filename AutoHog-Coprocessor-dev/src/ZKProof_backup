static void shake256_hash(
    const uint8_t* input,
    size_t input_len,
    uint8_t* output,
    size_t output_len
) {
    EVP_MD_CTX* ctx = EVP_MD_CTX_new();
    if (!ctx) throw std::runtime_error("Failed to create EVP context");
    EVP_DigestInit_ex(ctx, EVP_shake256(), nullptr);
    EVP_DigestUpdate(ctx, input, input_len);
    EVP_DigestFinalXOF(ctx, output, output_len);
    EVP_MD_CTX_free(ctx);
}

static __uint128_t decode_q(uint64_t q) {
    return (q == 0) ? ((__uint128_t)1 << 64) : (__uint128_t)q;
}

static std::vector<int64_t> compute_r1(
    const std::vector<int64_t>& e1,
    const std::vector<int64_t>& c1,
    const std::vector<int64_t>& a,
    const std::vector<int64_t>& r,
    size_t d,
    __uint128_t decoded_q
) {
    std::vector<int64_t> r1(d, 0);
    for (size_t i = 0; i < d; i++) {
        r1[i] = e1[i] - c1[i];
    }
    for (size_t i = 0; i < d; i++) {
        for (size_t j = 0; j < d; j++) {
            size_t idx = i + j;
            if (idx < d) {
                r1[idx] += a[i] * r[d - j - 1];
            } else {
                r1[idx - d] -= a[i] * r[d - j - 1];
            }
        }
    }
    for (size_t i = 0; i < d; i++) {
        __int128_t val = r1[i];
        r1[i] = static_cast<int64_t>(val / (__int128_t)decoded_q);
    }
    return r1;
}

static std::vector<int64_t> compute_r2(
    const std::vector<int64_t>& e2,
    const std::vector<int64_t>& c2,
    const std::vector<int64_t>& m,
    const std::vector<int64_t>& b,
    const std::vector<int64_t>& r,
    size_t d,
    uint64_t delta,
    __uint128_t decoded_q
) {

    std::vector<int64_t> r2(d, 0);
    for (size_t idx = 0; idx < d; idx++) {
        __int128_t val = (__int128_t)delta * m[idx] + e2[idx] - c2[idx];
        for (size_t j = 0; j < d; j++) {
            val += (__int128_t)r[d - j - 1] * b[j];
        }
        r2[idx] = static_cast<int64_t>(val / (__int128_t)decoded_q);
    }
    return r2;
}

static std::vector<uint8_t> signed_binary_decompose(int64_t value, size_t bits) {
    std::vector<uint8_t> result(bits);
    uint64_t uval = static_cast<uint64_t>(value);
    for (size_t i = 0; i < bits; i++) {
        result[i] = (uval >> i) & 1;
    }
    return result;
}

static std::vector<uint8_t> construct_witness(
    const std::vector<int64_t>& r,
    const std::vector<int64_t>& m,
    const std::vector<int64_t>& e1,
    const std::vector<int64_t>& e2,
    const std::vector<int64_t>& r1,
    const std::vector<int64_t>& r2,
    size_t d, uint64_t b, uint64_t b_r, uint64_t t,
    uint64_t msbs_zero_padding
) {
    std::vector<uint8_t> witness;
    uint64_t effective_t = t >> msbs_zero_padding;
    size_t log_t = effective_t > 1 ? (64 - __builtin_clzll(effective_t - 1)) : 1;
    size_t log_b = b > 0 ? (64 - __builtin_clzll(b)) + 1 : 1;
    size_t log_br = b_r > 0 ? (64 - __builtin_clzll(b_r)) + 1 : 1;


    for (size_t i = 0; i < d; i++) {
        witness.push_back(r[i] & 1);
    }

    for (size_t i = 0; i < d; i++) {
        auto bits = signed_binary_decompose(m[i], log_t);
        witness.insert(witness.end(), bits.begin(), bits.end());
    }

    for (size_t i = 0; i < d; i++) {
        auto bits = signed_binary_decompose(e1[i], log_b);
        witness.insert(witness.end(), bits.begin(), bits.end());
    }

    for (size_t i = 0; i < d; i++) {
        auto bits = signed_binary_decompose(e2[i], log_b);
        witness.insert(witness.end(), bits.begin(), bits.end());
    }

    for (size_t i = 0; i < d; i++) {
        auto bits = signed_binary_decompose(r1[i], log_br);
        witness.insert(witness.end(), bits.begin(), bits.end());
    }

    for (size_t i = 0; i < d; i++) {
        auto bits = signed_binary_decompose(r2[i], log_b);
        witness.insert(witness.end(), bits.begin(), bits.end());
    }
    return witness;
}

